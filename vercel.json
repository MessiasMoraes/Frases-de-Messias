{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/video.js": {
      "maxDuration": 300,
      "includeFiles": "public/trilhas/**"
    },
    "api/image.js": {
      "maxDuration": 15
    },
    "api/telegram-webhook.js": {
      "maxDuration": 300,
      "includeFiles": "dados/frases-bot.json"
    },
    "api/telegram-media.js": {
      "maxDuration": 300,
      "includeFiles": "public/trilhas/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/render-video",
      "destination": "/api/video.js"
    },
    {
      "source": "/api/video",
      "destination": "/api/video.js"
    },
    {
      "source": "/api/image",
      "destination": "/api/image.js"
    }
  ]
}
