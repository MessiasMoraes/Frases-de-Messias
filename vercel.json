{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/video.js": {
      "maxDuration": 300
    },
    "api/image.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/render-video",
      "destination": "/api/video.js"
    },
    {
      "source": "/api/video",
      "destination": "/api/video.js"
    },
    {
      "source": "/api/image",
      "destination": "/api/image.js"
    }
  ]
}
